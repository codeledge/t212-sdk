T212_ENVIRONMENT=DEMO
T212_API_KEY=
T212_API_SECRET=
# Optional ticker for tests (default: AAPL_US_EQ)
T212_TEST_TICKER=AAPL_US_EQ

# --- Browser client (internal endpoints) ---
# Cookie-based auth: paste the `Cookie` header from any request your logged-in
# browser makes to *.services.trading212.com. When set, the browser client uses
# a direct fetch instead of Playwright. cf_clearance is bound to the User-Agent
# that obtained it, so also set T212_USER_AGENT to that browser's navigator.userAgent.
T212_COOKIE=
T212_USER_AGENT=
