{
  "name": "t212-sdk",
  "version": "0.1.0",
  "description": "Fully typed TypeScript SDK for the Trading 212 Public API",
  "keywords": [
    "trading212",
    "t212",
    "trading",
    "stocks",
    "api",
    "sdk"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeledge/t212.git"
  },
  "bugs": {
    "url": "https://github.com/codeledge/t212/issues"
  },
  "homepage": "https://github.com/codeledge/t212#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "dotenv": "^16.5.0",
    "@types/node": "^22.15.21"
  }
}
