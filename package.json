{
  "name": "t212-sdk",
  "version": "0.3.2",
  "description": "The developer-first TypeScript SDK for Trading 212 — fully typed, zero deps, built-in rate limiting. Automate orders, positions, and portfolio data.",
  "keywords": [
    "trading212",
    "trading-212",
    "t212",
    "t212-sdk",
    "trading",
    "stocks",
    "equities",
    "invest",
    "isa",
    "api",
    "sdk",
    "typescript",
    "broker",
    "fintech",
    "algorithmic-trading",
    "portfolio"
  ],
  "license": "MIT",
  "author": "codeledge team (https://github.com/codeledge)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeledge/t212-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/codeledge/t212-sdk/issues"
  },
  "homepage": "https://github.com/codeledge/t212-sdk#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/minimist": "^1.2.5",
    "dotenv": "^17.4.2",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "bignumber.js": "^11.1.4",
    "date-fns": "^4.4.0",
    "deverything": "^5.5.2",
    "minimist": "^1.2.8",
    "zod": "^4.4.3"
  }
}
