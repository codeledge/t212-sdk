{
  "name": "t212-sdk",
  "version": "0.1.2",
  "description": "The developer-first TypeScript SDK for Trading 212 — fully typed, zero deps, built-in rate limiting. Automate orders, positions, and portfolio data.",
  "keywords": [
    "trading212",
    "trading-212",
    "t212",
    "t212-sdk",
    "trading",
    "stocks",
    "equities",
    "invest",
    "isa",
    "api",
    "sdk",
    "typescript",
    "broker",
    "fintech",
    "algorithmic-trading",
    "portfolio"
  ],
  "license": "MIT",
  "author": "codeledge team (https://github.com/codeledge)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeledge/t212-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/codeledge/t212-sdk/issues"
  },
  "homepage": "https://github.com/codeledge/t212-sdk#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "dotenv": "^16.5.0",
    "@types/node": "^22.15.21"
  }
}
